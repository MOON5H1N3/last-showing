# Copy this file to ".env" and fill it in. Lines starting with # are ignored.
#
# Only the secrets (TMDB key, Discord token and ID, dashboard password) have to live here.
# Everything else is a first-run default: once Last Showing is running, change it on the Settings page.

# ---- Your cinema ----
# The bit after /cinema/ in your Vue's web address, e.g. myvue.com/cinema/bristol-cribbs-causeway
VUE_CINEMA_SLUG=bristol-cribbs-causeway
# Leave blank; it's found automatically. (Cribbs Causeway is 10018.)
VUE_CINEMA_ID=

# ---- Your tickets ----
# monzo (Monzo Perks: 1 Vue ticket a month), custom, or none
TICKET_SOURCE=monzo
TICKETS_PER_MONTH=1
# Screen types your tickets can't be used for, comma separated. Blank = any showing counts.
# Examples: epic,3d,ultra-lux-and-lux
TICKET_EXCLUDED_FORMATS=
# How much to favour films that are about to leave, from 0 (always the best film) to 1 (never miss anything).
URGENCY_WEIGHT=0.5
# Extra predicted stars for films on your Letterboxd watchlist.
WATCHLIST_BOOST=0.25
# Include concerts, opera and theatre screenings in the plan (true/false).
INCLUDE_EVENTS=true

# ---- Letterboxd ----
LETTERBOXD_USERNAME=
# Read Letterboxd community averages from public film pages (true/false). Slow and polite: a few per run.
LETTERBOXD_COMMUNITY_RATINGS=true
LETTERBOXD_COMMUNITY_PER_RUN=40
# How many of your own rated films to backfill averages for per run (each takes ~4 seconds).
LETTERBOXD_BACKFILL_PER_RUN=150

# ---- How long films stay on ----
# Past Vue listings from Clusterflick (CC BY 4.0) teach Last Showing how long films really last.
VUE_HISTORY=true
# London Vues to learn from (the bit after /cinema/ in their Vue web address)
VUE_HISTORY_SITES=harrow,romford,croydon-purley-way,dagenham,eltham

# ---- TMDB (free) ----
# themoviedb.org > Settings > API. Either the "API Key" or the longer "API Read Access Token" works.
TMDB_API_KEY=

# ---- Discord ----
# From discord.com/developers > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Your own Discord user ID (Developer Mode on, then right-click your name > Copy User ID)
DISCORD_USER_ID=

# ---- Schedule ----
TZ=Europe/London
# The monthly plan is DMed on this day of the month, at this hour
MONTHLY_DAY=1
MONTHLY_HOUR=9
# Listings and your Letterboxd diary are checked every day at this hour
DAILY_REFRESH_HOUR=6

# ---- Dashboard ----
PORT=8095
# Address the Discord "Open dashboard" button links to. Use your server's LAN address to open it from your phone.
PUBLIC_URL=http://localhost:8095
# Optional. If set, the dashboard asks for this password (any username).
DASHBOARD_PASSWORD=
